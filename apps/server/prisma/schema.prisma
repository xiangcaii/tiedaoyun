// ============================================================================
// tiedaoyun 元数据 schema（HLD §5.3 核心元数据表，plan T6）
//
// 约定：
// - 本文件只包含「元数据表」。用户实体的运行时物理表由 data-model 模块
//   动态生成（T11），命名规则 `e_<app_slug>__<entity_slug>`（HLD §5.1，
//   见 @tiedaoyun/utils 的 physicalTableName），与元数据表命名空间隔离。
// - 主键统一 UUID v4（@default(uuid())）。
// - 审计字段：created_at / updated_at（部分表含 created_by / updated_by），
//   软删表带 deleted_at（对齐 HLD §5.1 BaseEntity mixin）。
// - 易扩展的词汇表（字段类型 / 连接器类型 / 审计事件等）用 String +
//   应用层校验（@tiedaoyun/schema-types）；稳定生命周期状态用 Prisma enum。
// - 级联策略：子集合随父删除（Cascade），历史/审计类引用 Restrict / SetNull。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 枚举（稳定生命周期状态；DB 中以小写字符串存储）
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("user_status")
}

enum MemberStatus {
  INVITED @map("invited")
  ACTIVE  @map("active")
  REMOVED @map("removed")

  @@map("member_status")
}

enum AppStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("app_status")
}

/// dev / test / prod 三态（HLD §8.2 版本策略、PRD §7.2.8）
enum VersionEnv {
  DEV  @map("dev")
  TEST @map("test")
  PROD @map("prod")

  @@map("version_env")
}

enum VersionStatus {
  DRAFT       @map("draft")
  PUBLISHED   @map("published")
  ROLLED_BACK @map("rolled_back")

  @@map("version_status")
}

/// 表单 / 列表 / 页面 / 流程定义的发布状态
enum DefinitionStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("definition_status")
}

enum RelationType {
  ONE_TO_ONE   @map("one_to_one")
  ONE_TO_MANY  @map("one_to_many")
  MANY_TO_ONE  @map("many_to_one")
  MANY_TO_MANY @map("many_to_many")

  @@map("relation_type")
}

enum WorkflowInstanceStatus {
  RUNNING    @map("running")
  SUSPENDED  @map("suspended")
  COMPLETED  @map("completed")
  TERMINATED @map("terminated")

  @@map("workflow_instance_status")
}

enum WorkflowTaskType {
  APPROVAL @map("approval")
  CC       @map("cc")

  @@map("workflow_task_type")
}

enum WorkflowTaskStatus {
  PENDING     @map("pending")
  APPROVED    @map("approved")
  REJECTED    @map("rejected")
  TRANSFERRED @map("transferred")
  CANCELED    @map("canceled")

  @@map("workflow_task_status")
}

enum ConnectorCallStatus {
  SUCCESS @map("success")
  FAILED  @map("failed")
  TIMEOUT @map("timeout")

  @@map("connector_call_status")
}

enum MigrationStatus {
  PENDING     @map("pending")
  APPLIED     @map("applied")
  FAILED      @map("failed")
  ROLLED_BACK @map("rolled_back")

  @@map("migration_status")
}

// ---------------------------------------------------------------------------
// 用户 / 工作空间 / 角色 / 权限（HLD §7）
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  phone        String?    @unique
  name         String
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  isSuperadmin Boolean    @default(false) @map("is_superadmin")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  ownedWorkspaces    Workspace[]        @relation("WorkspaceOwner")
  memberships        WorkspaceMember[]
  workflowInstances  WorkflowInstance[] @relation("InstanceInitiator")
  workflowTasks      WorkflowTask[]     @relation("TaskAssignee")
  workflowLogs       WorkflowLog[]      @relation("LogOperator")
  files              File[]             @relation("FileUploader")
  auditLogs          AuditLog[]         @relation("AuditUser")

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  ownerId   String   @map("owner_id") @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members    WorkspaceMember[]
  roles      Role[]
  apps       App[]
  connectors Connector[]
  files      File[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  roleId      String?      @map("role_id") @db.Uuid
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime?    @map("joined_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("workspace_members")
}

/// 角色：workspace_id 为空表示内置角色（HLD §7.3 静态预置）
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  code        String
  name        String
  description String?
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  rolePermissions RolePermission[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("roles")
}

/// 权限点（功能级，如 app.create / designer.edit；行/字段级策略存 Role.config）
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  category    String
  isBuiltin   Boolean  @default(true) @map("is_builtin")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// 应用 / 版本（HLD §5.3、PRD §7.2.8）
// ---------------------------------------------------------------------------

model App {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  slug        String
  description String?
  icon        String?
  status      AppStatus @default(DRAFT)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions   AppVersion[]
  entities   Entity[]
  relations  Relation[]
  forms      Form[]
  lists      List[]
  pages      Page[]
  workflows  Workflow[]
  instances  WorkflowInstance[]
  connectors Connector[]
  migrations AppMigration[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("apps")
}

model AppVersion {
  id          String        @id @default(uuid()) @db.Uuid
  appId       String        @map("app_id") @db.Uuid
  version     Int
  env         VersionEnv    @default(DEV)
  status      VersionStatus @default(DRAFT)
  changelog   String?
  snapshot    Json?         // 发布时的 app 全量定义快照（实体/表单/列表/页面/流程）
  publishedBy String?       @map("published_by") @db.Uuid
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, env, version])
  @@index([appId])
  @@map("app_versions")
}

// ---------------------------------------------------------------------------
// 数据模型元数据（HLD §5.3；物理表由 T11 动态生成）
// ---------------------------------------------------------------------------

model Entity {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @map("app_id") @db.Uuid
  name        String   // 展示名（如「请假单」）
  slug        String   // 实体标识（如 leave）
  tableName   String   @map("table_name") // 物理表名 e_<app_slug>__<entity_slug>
  description String?
  status      String   @default("active")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  app          App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  fields       Field[]
  relationsFrom Relation[]    @relation("RelationSource")
  relationsTo   Relation[]    @relation("RelationTarget")
  forms        Form[]
  lists        List[]
  migrations   AppMigration[]

  @@unique([appId, slug])
  @@unique([appId, tableName])
  @@index([appId])
  @@map("entities")
}

/// 字段元数据。type 为可扩展词汇表（text/number/date/enum/attachment/relation/
/// formula 等 15+，PRD §7.2.1），由 schema-types 在校验层约束；type 相关
/// 选项（枚举值、精度、关联目标等）存 config JSONB。
/// 删除默认软删：deprecated = true（HLD §5.2）。
model Field {
  id           String   @id @default(uuid()) @db.Uuid
  entityId     String   @map("entity_id") @db.Uuid
  name         String   // 列名（字母/数字/下划线，≤64 字符，PRD §7.2.1）
  label        String   // 展示名
  type         String
  config       Json     @default("{}")
  required     Boolean  @default(false)
  unique       Boolean  @default(false)
  defaultValue String?  @map("default_value")
  isSystem     Boolean  @default(false) @map("is_system") // 审计列等系统字段
  deprecated   Boolean  @default(false)
  sortOrder    Int      @default(0) @map("sort_order")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entity    Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  relations Relation[] @relation("RelationSourceField")

  @@unique([entityId, name])
  @@index([entityId])
  @@map("fields")
}

/// 关系元数据（HLD §5.1：主子表独立表 + 外键，多对多走中间表）
model Relation {
  id             String       @id @default(uuid()) @db.Uuid
  appId          String       @map("app_id") @db.Uuid
  name           String
  type           RelationType
  sourceEntityId String       @map("source_entity_id") @db.Uuid
  sourceFieldId  String?      @map("source_field_id") @db.Uuid
  targetEntityId String       @map("target_entity_id") @db.Uuid
  junctionTable  String?      @map("junction_table") // 多对多中间表 e_<a>__<b>__rel
  onDelete       String       @default("restrict") @map("on_delete") // restrict/cascade/set_null
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  app          App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  sourceEntity Entity @relation("RelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  sourceField  Field? @relation("RelationSourceField", fields: [sourceFieldId], references: [id], onDelete: SetNull)
  targetEntity Entity @relation("RelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("relations")
}

// ---------------------------------------------------------------------------
// 表单 / 列表 / 页面 / 流程定义（JSONB schema，HLD §9.1）
// ---------------------------------------------------------------------------

model Form {
  id          String           @id @default(uuid()) @db.Uuid
  appId       String           @map("app_id") @db.Uuid
  entityId    String?          @map("entity_id") @db.Uuid
  name        String
  schema      Json             // { components, dataModelRef, rules, fieldPerms }
  version     Int              @default(1)
  status      DefinitionStatus @default(DRAFT)
  description String?
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  app    App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([entityId])
  @@map("forms")
}

model List {
  id          String           @id @default(uuid()) @db.Uuid
  appId       String           @map("app_id") @db.Uuid
  entityId    String           @map("entity_id") @db.Uuid
  name        String
  schema      Json             // { dataModelRef, columns, filters, sorts, viewType, pageSize }
  version     Int              @default(1)
  status      DefinitionStatus @default(DRAFT)
  description String?
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([entityId])
  @@map("lists")
}

model Page {
  id          String           @id @default(uuid()) @db.Uuid
  appId       String           @map("app_id") @db.Uuid
  name        String
  path        String?          // 运行时路由路径
  schema      Json             // { layout, components, dataSources, actions }
  version     Int              @default(1)
  status      DefinitionStatus @default(DRAFT)
  description String?
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// 流程定义 / 实例 / 任务 / 日志（HLD §8）
// ---------------------------------------------------------------------------

model Workflow {
  id          String           @id @default(uuid()) @db.Uuid
  appId       String           @map("app_id") @db.Uuid
  name        String
  description String?
  definition  Json             // { nodes, edges, triggers }
  version     Int              @default(1)
  env         VersionEnv       @default(DEV)
  status      DefinitionStatus @default(DRAFT)
  changelog   String?
  publishedBy String?          @map("published_by") @db.Uuid
  publishedAt DateTime?        @map("published_at")
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  app       App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  instances WorkflowInstance[]

  @@index([appId])
  @@map("workflows")
}

model WorkflowInstance {
  id              String                 @id @default(uuid()) @db.Uuid
  workflowId      String                 @map("workflow_id") @db.Uuid
  workflowVersion Int                    @map("workflow_version") // 绑定定义版本（HLD §8.2 默认沿用旧版）
  appId           String                 @map("app_id") @db.Uuid
  status          WorkflowInstanceStatus @default(RUNNING)
  currentNodeId   String?                @map("current_node_id") // 不变量：单实例单 running 节点（HLD §8.3）
  data            Json                   @default("{}") // 流程上下文 / 表单数据快照
  initiatorId     String                 @map("initiator_id") @db.Uuid
  startedAt       DateTime               @default(now()) @map("started_at")
  endedAt         DateTime?              @map("ended_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  workflow  Workflow       @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  app       App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  initiator User           @relation("InstanceInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  tasks     WorkflowTask[]
  logs      WorkflowLog[]

  @@index([workflowId])
  @@index([appId])
  @@index([initiatorId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_instances")
}

model WorkflowTask {
  id          String            @id @default(uuid()) @db.Uuid
  instanceId  String            @map("instance_id") @db.Uuid
  nodeId      String            @map("node_id")
  nodeName    String?           @map("node_name")
  type        WorkflowTaskType  @default(APPROVAL)
  assigneeId  String            @map("assignee_id") @db.Uuid // 进入节点时冻结（HLD §8.3）
  status      WorkflowTaskStatus @default(PENDING)
  comment     String?
  payload     Json?
  dueAt       DateTime?         @map("due_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  logs     WorkflowLog[]

  @@index([instanceId])
  @@index([assigneeId, status])
  @@map("workflow_tasks")
}

/// 流程操作日志：append-only，含原值/新值，保证可重放（HLD §8.2）
model WorkflowLog {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  taskId     String?  @map("task_id") @db.Uuid
  nodeId     String?  @map("node_id")
  action     String   // start/approve/reject/transfer/rollback/add-sign/...
  operatorId String?  @map("operator_id") @db.Uuid
  comment    String?
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task     WorkflowTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  operator User?            @relation("LogOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@index([taskId])
  @@index([createdAt])
  @@map("workflow_logs")
}

// ---------------------------------------------------------------------------
// 审计（HLD §11.1）
// ---------------------------------------------------------------------------

/// 审计日志：append-only。event 为可扩展词汇表
/// （LOGIN / PERMISSION_CHANGE / DATA_* / WORKFLOW_* / CONNECTOR_CALL / APP_PUBLISH / EXPORT）。
/// workspace_id 故意不做外键：工作空间删除后审计仍须保留。
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  event        String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  detail       Json?    // 敏感字段写入前已脱敏
  ip           String?
  userAgent    String?  @map("user_agent")
  traceId      String?  @map("trace_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 连接器（HLD §10）
// ---------------------------------------------------------------------------

/// 连接器定义。type 为可扩展词汇表（http/webhook/mysql/postgres/email/sms/wecom/storage）。
/// config 只存非敏感配置；鉴权材料经 KMS 加密后以引用形式存 secret_ref（HLD §10.2）。
model Connector {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  appId       String?  @map("app_id") @db.Uuid
  name        String
  type        String
  description String?
  config      Json     @default("{}")
  secretRef   String?  @map("secret_ref")
  enabled     Boolean  @default(true)
  timeoutMs   Int      @default(10000) @map("timeout_ms") // 1–60s，默认 10s（HLD §10.3）
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  app       App?            @relation(fields: [appId], references: [id], onDelete: SetNull)
  calls     ConnectorCall[]

  @@index([workspaceId])
  @@index([appId])
  @@map("connectors")
}

/// 连接器调用记录：请求/响应摘要已脱敏，保留 90 天（HLD §10.3）
model ConnectorCall {
  id                 String              @id @default(uuid()) @db.Uuid
  connectorId        String              @map("connector_id") @db.Uuid
  workflowInstanceId String?             @map("workflow_instance_id") @db.Uuid // 关联流程实例（无外键，实例清理不影响记录保留策略）
  requestSummary     Json?               @map("request_summary")
  responseStatus     Int?                @map("response_status")
  responseSummary    Json?               @map("response_summary")
  durationMs         Int?                @map("duration_ms")
  status             ConnectorCallStatus
  error              String?
  traceId            String?             @map("trace_id")
  createdAt          DateTime            @default(now()) @map("created_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, createdAt])
  @@index([status])
  @@map("connector_calls")
}

// ---------------------------------------------------------------------------
// 文件 / 迁移记录
// ---------------------------------------------------------------------------

model File {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  uploaderId  String    @map("uploader_id") @db.Uuid
  name        String
  mime        String
  size        BigInt
  storageType String    @default("local") @map("storage_type") // HLD §2 StorageProvider
  storageKey  String    @map("storage_key") // 本地卷路径 / 对象存储 key
  hash        String?
  refType     String?   @map("ref_type") // 引用方（entity 记录 / 表单附件 ...）
  refId       String?   @map("ref_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([uploaderId])
  @@map("files")
}

/// schema 迁移记录：所有迁移可回看（HLD §5.2）
model AppMigration {
  id        String          @id @default(uuid()) @db.Uuid
  appId     String?         @map("app_id") @db.Uuid
  entityId  String?         @map("entity_id") @db.Uuid
  name      String          // 迁移名（与物理表变更对应）
  sql       String?
  status    MigrationStatus @default(PENDING)
  error     String?
  appliedAt DateTime?       @map("applied_at")
  createdBy String?         @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")

  app    App?    @relation(fields: [appId], references: [id], onDelete: SetNull)
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([entityId])
  @@index([status])
  @@map("app_migrations")
}
