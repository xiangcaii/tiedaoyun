# tiedaoyun 环境变量示例
# 复制为 .env 并按需修改
# - 本地开发：复制到仓库根目录
# - Docker 部署：复制到 deploy/.env

# ===== Node 运行环境 =====
NODE_ENV=development

# ===== 后端服务（apps/server）=====
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
# JWT 密钥（生产环境务必改为强随机值）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 字段级加密密钥（AES-256，32 字节十六进制）
FIELD_ENCRYPTION_KEY=change-me-32-bytes-hex-encryption-key
# 前端 origin（CORS 受控；refresh token cookie 需 credentials）
WEB_ORIGIN=http://localhost:5173
# refresh token cookie SameSite 策略：lax / strict / none（默认 lax）
AUTH_COOKIE_SAMESITE=lax

# ===== 数据库（PostgreSQL）=====
# 本地开发用（容器内由 docker-compose 注入 PG* 变量覆盖）
DATABASE_URL=postgresql://tiedaoyun:tiedaoyun@localhost:5432/tiedaoyun
# Docker 部署用（postgres 容器初始化）
POSTGRES_USER=tiedaoyun
POSTGRES_PASSWORD=tiedaoyun
POSTGRES_DB=tiedaoyun

# ===== 缓存 / 队列（Redis）=====
REDIS_URL=redis://localhost:6379

# ===== 文件存储（本地卷）=====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# ===== 前端（apps/web）=====
VITE_API_BASE_URL=/api/v1

# ===== Docker Compose 部署 =====
# 宿主机暴露端口（默认 80）
NGINX_PORT=80
